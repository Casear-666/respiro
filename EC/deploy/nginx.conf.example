# 精力日历 nginx 反向代理示例：/etc/nginx/sites-available/energy-calendar
# 仅在打算跳过 SSH 隧道、直接对外提供 HTTPS 访问时使用。
# 证书路径为占位符，请使用已有的证书（例如 certbot 签发的 Let's Encrypt 证书）。
#
# 配套 .env.server：
#   CALENDAR_HOST=127.0.0.1
#   CALENDAR_PORT=3001
#   CALENDAR_SECURE_COOKIE=true
#   CALENDAR_PUBLIC_ORIGIN=https://calendar.example.com

server {
    listen 443 ssl;
    server_name calendar.example.com;

    ssl_certificate     /etc/letsencrypt/live/calendar.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/calendar.example.com/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }
}

# 可选：HTTP 跳转 HTTPS
# server {
#     listen 80;
#     server_name calendar.example.com;
#     return 301 https://$host$request_uri;
# }

# 精力日历服务器配置示例。
# 复制为 .env.server 后按需修改；.env.server 已在 .gitignore 中，不会提交。

# 监听地址与端口。默认仅本机回环，配 SSH 隧道即可使用。
CALENDAR_HOST=127.0.0.1
CALENDAR_PORT=3001

# 数据目录（账号库 users/ 下按账号保存各自的 calendar.sqlite 与备份）。
CALENDAR_DATA_DIR=./data

# 仅本机或 SSH 隧道访问保持 false；经 HTTPS 反向代理对外服务时改为 true。
CALENDAR_SECURE_COOKIE=false

# 是否开放注册（默认 true；false 时保留登录和管理员建号）。
CALENDAR_ALLOW_REGISTRATION=true

# 仅在本机 nginx 反代时启用，使用其追加的真实来源 IP 做注册限流。
CALENDAR_TRUST_PROXY=false

# 对外访问的完整来源地址；配合上面的 true 使用。
# CALENDAR_PUBLIC_ORIGIN=https://calendar.example.com

# 静态构建产物目录（默认仓库 dist/，一般无需修改）。
# CALENDAR_DIST_DIR=./dist

# 可选：Gemini API 服务端智能能力配置（不配置时日历功能与离线同步照常运行）。
# 在 Google AI Studio（https://aistudio.google.com/apikey）创建的免费层 Key 直接填入 GEMINI_API_KEY 即可，无需切换接口地址。
# GEMINI_API_KEY=
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_CAPTURE_MODEL=gemini-3.8-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_DECISION_MODEL=gemini-decision-1
# 如需纯单模型免费层模式以最大化节省 RPM 配额，可将上面两项也设为 gemini-3.8-flash：
# GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
# GEMINI_DECISION_MODEL=gemini-3.8-flash
# GEMINI_AI_RATE_LIMIT=15
# GEMINI_TIMEOUT_MS=60000

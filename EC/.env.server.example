# 精力日历服务器配置示例。
# 复制为 .env.server 后按需修改；.env.server 已在 .gitignore 中，不会提交。

# 监听地址与端口。默认仅本机回环，配 SSH 隧道即可使用。
CALENDAR_HOST=127.0.0.1
CALENDAR_PORT=3001

# 数据目录（账号库 users/ 下按账号保存各自的 calendar.sqlite 与备份）。
CALENDAR_DATA_DIR=./data

# 仅本机或 SSH 隧道访问保持 false；经 HTTPS 反向代理对外服务时改为 true。
CALENDAR_SECURE_COOKIE=false

# 对外访问的完整来源地址；配合上面的 true 使用。
# CALENDAR_PUBLIC_ORIGIN=https://calendar.example.com

# 静态构建产物目录（默认仓库 dist/，一般无需修改）。
# CALENDAR_DIST_DIR=./dist
